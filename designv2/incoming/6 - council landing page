}

/* =========================================================
   DECISION SUPPORT
   ========================================================= */

.abv2-decision{
  margin:26px 0 34px;
}

.abv2-decision > * + *{
  margin-top:18px;
}

.abv2-card{
  border:1.5px solid rgba(38,38,37,.12);
  border-radius:24px;
  background:#fff;
  box-shadow:0 10px 30px rgba(38,38,37,.05);
}

.abv2-card__inner{
  padding:24px 24px 22px;
}

.abv2-card__title{
  margin:0 0 10px;
  font-size:clamp(1.25rem,2vw,1.55rem);
  line-height:1.15;
}

.abv2-card__intro{
  margin:0;
}

/* compare */

.abv2-compare{
  overflow:hidden;
}

.abv2-compare__grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:0;
  border-top:1px solid rgba(38,38,37,.10);
}

.abv2-compare__col{
  padding:22px 24px 24px;
}

.abv2-compare__col + .abv2-compare__col{
  border-left:1px solid rgba(38,38,37,.10);
}

.abv2-compare__label{
  margin:0 0 12px;
  font-size:.78rem;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.04em;
  color:rgba(38,38,37,.62);
}

.abv2-compare__heading{
  display:block;
  margin:0 0 12px;
  font-size:1.15rem;
  line-height:1.18;
}

.abv2-compare__note{
  margin:0;
  padding:16px 24px 20px;
  border-top:1px solid rgba(38,38,37,.10);
  font-size:.95rem;
  color:rgba(38,38,37,.78);
}

/* pro/con */

.abv2-procon{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:18px;
}

.abv2-procon__col{
  border:1.5px solid rgba(38,38,37,.10);
  border-radius:22px;
  padding:20px 20px 18px;
  background:#fff;
}

.abv2-procon__col--pros{
  background:rgba(0,164,182,.06);
}

.abv2-procon__col--cons{
  background:rgba(226,109,166,.06);
}

.abv2-procon__title{
  display:block;
  margin:0 0 12px;
  font-size:1.02rem;
  line-height:1.2;
}

/* fit */

.abv2-fit{
  overflow:hidden;
}

.abv2-fit__top{
  padding:24px 24px 18px;
}

.abv2-fit__grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:0;
  border-top:1px solid rgba(38,38,37,.10);
}

.abv2-fit__pane{
  padding:20px 24px 22px;
}

.abv2-fit__pane + .abv2-fit__pane{
  border-left:1px solid rgba(38,38,37,.10);
}

.abv2-fit__pane--yes{
  background:rgba(0,164,182,.04);
}

.abv2-fit__pane--no{
  background:rgba(226,109,166,.05);
}

.abv2-fit__heading{
  display:block;
  margin:0 0 12px;
  font-size:1rem;
  line-height:1.2;
}

.abv2-fit__footer{
  padding:16px 24px 22px;
  border-top:1px solid rgba(38,38,37,.10);
  font-size:.95rem;
  color:rgba(38,38,37,.78);
}

/* faq */

.abv2-faq{
  display:grid;
  gap:12px;
}

.abv2-faq__item{
  border:1.5px solid rgba(38,38,37,.10);
  border-radius:18px;
  background:#fff;
  overflow:hidden;
}

.abv2-faq__item summary{
  position:relative;
  list-style:none;
  cursor:pointer;
  padding:18px 52px 18px 18px;
  font-family:var(--abv2-ui);
  font-weight:700;
  line-height:1.4;
}

.abv2-faq__item summary::-webkit-details-marker{
  display:none;
}

.abv2-faq__item summary::after{
  content:"+";
  position:absolute;
  right:18px;
  top:50%;
  width:22px;
  height:18px;
  transform:translateY(-50%);
  background:rgba(239,181,42,.18);
  color:transparent;
  -webkit-mask-image:var(--abv2-dot-mask);
  -webkit-mask-repeat:no-repeat;
  -webkit-mask-position:center;
  -webkit-mask-size:contain;
  mask-image:var(--abv2-dot-mask);
  mask-repeat:no-repeat;
  mask-position:center;
  mask-size:contain;
}

.abv2-faq__item[open] summary::after{
  color:transparent;
}

.abv2-faq__answer{
  padding:0 18px 18px;
  border-top:1px solid rgba(38,38,37,.08);
}

.abv2-faq__answer p{
  margin:14px 0 0;
}

/* =========================================================
   DATA / FINANCIAL
   ========================================================= */

.abv2-data{
  margin:26px 0 34px;
}

.abv2-data > * + *{
  margin-top:18px;
}

.abv2-slab{
  border:1.5px solid rgba(38,38,37,.10);
  border-radius:22px;
  background:#fff;
  box-shadow:0 10px 30px rgba(38,38,37,.04);
}

.abv2-slab__inner{
  padding:22px 22px 20px;
}

.abv2-slab__title{
  margin:0 0 10px;
  font-size:clamp(1.18rem,1.8vw,1.42rem);
  line-height:1.14;
}

.abv2-slab__intro{
  margin:0;
}

/* stats */

.abv2-stats{
  display:grid;
  grid-template-columns:repeat(4, 1fr);
  gap:14px;
}

.abv2-stat{
  padding:18px 16px 18px;
  border:1.5px solid rgba(38,38,37,.08);
  border-radius:22px;
  background:#faf8f8;
  box-shadow:none;
}

.abv2-stat:nth-child(1){ background:#f8d9e8; }
.abv2-stat:nth-child(2){ background:#dff4f6; }
.abv2-stat:nth-child(3){ background:#f6e7c8; }
.abv2-stat:nth-child(4){ background:#f3edf9; }

.abv2-stat__label{
  display:flex;
  align-items:flex-start;
  gap:8px;
  margin:0 0 10px;
  font-size:.78rem;
  line-height:1.28;
  font-weight:700;
  letter-spacing:.04em;
  text-transform:uppercase;
  color:rgba(38,38,37,.72);
}

.abv2-stat__value{
  margin:0 0 8px;
  font-family:var(--abv2-serif);
  font-weight:600;
  font-size:clamp(1.55rem,2vw,2rem);
  line-height:.96;
  letter-spacing:-.03em;
  color:var(--abv2-ink);
}

.abv2-stat__note{
  margin:0;
  font-size:.95rem;
  line-height:1.52;
  color:rgba(38,38,37,.78);
}

/* table */

.abv2-table-wrap{
  overflow-x:auto;
  -webkit-overflow-scrolling:touch;
}

.abv2-table{
