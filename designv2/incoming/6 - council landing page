.abv2-egp{
  margin:26px 0 34px;
}

/* ---------- shell ---------- */

.abv2-egp__card{
  overflow:hidden;
}

.abv2-egp__top{
  padding-bottom:0;
}

.abv2-egp__eyebrow{
  margin:0 0 10px;
