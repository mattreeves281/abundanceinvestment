}

.abv2-egp__stat:nth-child(1){ background:#f8d9e8; }
.abv2-egp__stat:nth-child(2){ background:#dff4f6; }
.abv2-egp__stat:nth-child(3){ background:#f6e7c8; }

.abv2-egp__stat-label{
  display:block;
  margin:0 0 8px;
  font-family:var(--abv2-ui);
  font-size:.74rem;
  line-height:1.2;
  font-weight:700;
  letter-spacing:.04em;
