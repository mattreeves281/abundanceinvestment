/* details */

.abv2-details{
  display:grid;
  gap:12px;
}

.abv2-details__item{
  border:1.5px solid rgba(38,38,37,.08);
  border-radius:18px;
  background:#fff;
  overflow:hidden;
}

.abv2-details__item summary{
  position:relative;
  list-style:none;
  cursor:pointer;
  padding:16px 48px 16px 18px;
  font-family:var(--abv2-ui);
  font-size:.95rem;
  line-height:1.35;
  font-weight:700;
  color:var(--abv2-ink);
}

.abv2-details__item summary::-webkit-details-marker{
  display:none;
}

.abv2-details__item summary::after{
  content:"+";
  position:absolute;
  right:16px;
  top:50%;
  width:22px;
  height:18px;
  transform:translateY(-50%);
  background:rgba(0,164,182,.15);
  color:transparent;
  -webkit-mask-image:var(--abv2-dot-mask);
  -webkit-mask-repeat:no-repeat;
  -webkit-mask-position:center;
  -webkit-mask-size:contain;
  mask-image:var(--abv2-dot-mask);
  mask-repeat:no-repeat;
  mask-position:center;
  mask-size:contain;
}

.abv2-details__item[open] summary::after{
  color:transparent;
}

.abv2-details__body{
  padding:0 18px 18px;
  border-top:1px solid rgba(38,38,37,.08);
}

.abv2-details__body > *:first-child{
