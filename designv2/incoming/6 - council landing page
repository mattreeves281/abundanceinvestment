  margin:18px auto -62px;
  pointer-events:none;
}

.abv2-ed-illus-top__blob{
  position:absolute;
  left:-34px;
  top:0;
  width:360px;
  aspect-ratio:1 / 1;
}

.abv2-ed-illus-top__blob::before{
  content:"";
  position:absolute;
  inset:0;
  z-index:1;
  background:var(--abv2-pink);
  -webkit-mask-image:var(--abv2-dot-mask);
  -webkit-mask-repeat:no-repeat;
  -webkit-mask-position:center;
