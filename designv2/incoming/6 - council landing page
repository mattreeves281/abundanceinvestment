/* =========================================================
   BLOB / DECORATIVE UTILITIES
   ========================================================= */

.abv2-card--with-blob{
  position:relative;
  overflow:visible;
}

.abv2-card--with-blob::after{
  content:"";
  position:absolute;
  top:-36px;
  right:-36px;
  width:150px;
  height:135px;
  opacity:.16;
  background:var(--abv2-teal);
  -webkit-mask-image:var(--abv2-dot-mask);
  -webkit-mask-repeat:no-repeat;
  -webkit-mask-position:center;
  -webkit-mask-size:contain;
  mask-image:var(--abv2-dot-mask);
  mask-repeat:no-repeat;
  mask-position:center;
  mask-size:contain;
}

.abv2-card--blob-anchor,
.abv2-slab--blob-anchor,
.abv2-navcard--blob-anchor,
.abv2-riskcard--blob-anchor,
.abv2-ctacard--blob-anchor{
  position:relative;
  overflow:visible;
  z-index:1;
}

.abv2-card--blob-anchor::before,
.abv2-slab--blob-anchor::before,
.abv2-navcard--blob-anchor::before,
.abv2-riskcard--blob-anchor::before,
.abv2-ctacard--blob-anchor::before{
  content:"";
  position:absolute;
  top:-42px;
  right:-42px;
  width:180px;
  height:160px;
  z-index:-1;
  background:var(--abv2-teal);
  -webkit-mask-image:var(--abv2-dot-mask);
  -webkit-mask-repeat:no-repeat;
  -webkit-mask-position:center;
  -webkit-mask-size:contain;
  mask-image:var(--abv2-dot-mask);
  mask-repeat:no-repeat;
  mask-position:center;
  mask-size:contain;
}

.abv2-card--blob-anchor.abv2-card--blob-anchor-pink::before,
.abv2-slab--blob-anchor.abv2-slab--blob-anchor-pink::before,
.abv2-navcard--blob-anchor.abv2-navcard--blob-anchor-pink::before,
.abv2-riskcard--blob-anchor.abv2-riskcard--blob-anchor-pink::before,
.abv2-ctacard--blob-anchor.abv2-ctacard--blob-anchor-pink::before{
  background:var(--abv2-pink);
}

.abv2-card--blob-anchor.abv2-card--blob-anchor-yellow::before,
.abv2-slab--blob-anchor.abv2-slab--blob-anchor-yellow::before,
.abv2-navcard--blob-anchor.abv2-navcard--blob-anchor-yellow::before,
.abv2-riskcard--blob-anchor.abv2-riskcard--blob-anchor-yellow::before,
.abv2-ctacard--blob-anchor.abv2-ctacard--blob-anchor-yellow::before{
