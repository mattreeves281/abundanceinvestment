<style>
  @font-face{
    font-family:"New Kansas";
    src:url("https://shareinmicrosite.blob.core.windows.net/abundance/258554e0-7d5c-40cd-a6a2-80d5eb9fdd2f.woff2") format("woff2");
    font-weight:600;
    font-style:normal;
    font-display:swap;
  }

  @font-face{
    font-family:"Sohne Buch";
    src:url("https://shareinmicrosite.blob.core.windows.net/abundance/0976f15f-54f3-4c7c-a261-c8a91b64dbfb.woff2") format("woff2");
    font-weight:400;
    font-style:normal;
    font-display:swap;
  }

  @font-face{
    font-family:"Sohne Kraftig";
    src:url("https://shareinmicrosite.blob.core.windows.net/abundance/cab3babc-20c2-4152-bcf5-dc28aa6f2df4.woff2") format("woff2");
    font-weight:600;
    font-style:normal;
    font-display:swap;
  }

  :root{
    --abv2-bg:#ffffff;
    --abv2-white:#ffffff;
    --abv2-ink:#262625;
    --abv2-text:#4d4a46;
    --abv2-pink:#df73ad;
    --abv2-yellow:#efb52a;
    --abv2-teal:#12a9bb;
    --abv2-editorial-bg:#ffffff;

    --abv2-wrap:1180px;
    --abv2-editorial-rail:760px;
    --abv2-editorial-copy:58ch;
    --abv2-mobile-copy-rail:392px;

    --abv2-serif:"New Kansas", Georgia, serif;
    --abv2-sans:"Sohne Buch", Arial, sans-serif;
    --abv2-ui:"Sohne Kraftig", Arial, sans-serif;

    --abv2-dot-mask:url("data:image/svg+xml,%3Csvg%20width%3D%22200%22%20height%3D%22200%22%20viewBox%3D%220%200%20200%20200%22%20fill%3D%22none%22%20xmlns%3D%22http://www.w3.org/2000/svg%22%3E%3Cpath%20fill-rule%3D%22evenodd%22%20clip-rule%3D%22evenodd%22%20d%3D%22M99.3243%20200C174.509%20200%20190.531%20154.684%20198.649%20100.137C209.406%2027.8664%20154.063%20-3.34294%2099.3243%200.282052C35.8709%204.47904%200%2044.9903%200%20100.137C0%20155.285%2023.2712%20200%2099.3243%20200Z%22%20fill%3D%22black%22/%3E%3C/svg%3E");
  }

  html,
  body{
    overflow-x:hidden;
    background:var(--abv2-editorial-bg);
  }

  body{
    margin:0;
    color:var(--abv2-ink);
    font-family:var(--abv2-sans);
  }

  .main-content,
  .page-content,
  .content-wrapper{
    background:var(--abv2-editorial-bg) !important;
  }

  /* =========================================================
     NAV
     ========================================================= */

  .site-navbar{
    background:#fff !important;
    border-bottom:0 !important;
    box-shadow:none !important;
    padding:14px 0 10px;
  }

  .site-navbar::after{ display:none !important; }

  .site-navbar,
  .site-navbar .brand-navbar,
  .site-navbar .container,
  .site-navbar .navbar{
    border:0 !important;
    box-shadow:none !important;
    background:#fff !important;
  }

  .site-navbar .container{
    width:min(calc(100% - 34px), 1240px);
    max-width:none;
  }

  .site-navbar .brand-navbar{
    min-height:68px;
    margin:0;
  }

  .site-navbar .brand-navbar-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    min-height:68px;
  }

  .site-navbar .logo-wrapper{
    display:flex;
    align-items:center;
    padding:0;
  }

  .site-navbar .logo{
    width:124px;
    height:auto;
    max-width:none;
    content:url("https://shareinmicrosite.blob.core.windows.net/abundance/30747a8f-bc62-45f9-9ae6-d8734ddc645b.png");
  }

  .site-navbar #navbar{
    background:transparent;
    border:0;
    box-shadow:none;
  }

  .site-navbar .navbar-is-collapsed{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:24px;
  }

  .site-navbar .navbar-main{
    display:flex;
    align-items:center;
    gap:34px;
    float:none;
    margin:0 auto;
    padding:0;
  }

  .site-navbar .navbar-main > li{
    float:none;
  }

  .site-navbar .brand-navbar-nav__parent-item-link{
    padding:10px 0 !important;
    padding-right:0 !important;
    font-family:var(--abv2-ui);
    font-size:.9rem;
    line-height:1;
    color:var(--abv2-ink) !important;
    background:none !important;
  }

  .site-navbar .brand-navbar-nav__parent-item-link:hover{
    color:var(--abv2-pink) !important;
  }

  .site-navbar .brand-navbar-nav__parent-item-link svg,
  .site-navbar .brand-navbar-nav__parent-item-link i,
  .site-navbar .brand-navbar-nav__parent-item-link .fa,
  .site-navbar .brand-navbar-nav__parent-item-link .icon,
  .site-navbar .brand-navbar-nav__parent-item-link::after{
    display:none !important;
  }

  .site-navbar .brand-navbar--account-partial{
    display:flex;
    align-items:center;
    margin:0;
    padding:0;
  }

  .site-navbar .brand-navbar__auth-btn-wrapper{
    display:flex;
    align-items:center;
    gap:18px;
  }

  .site-navbar .brand-navbar__login-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:0 !important;
    border:0 !important;
    background:transparent !important;
    box-shadow:none !important;
    font-family:var(--abv2-ui) !important;
    font-size:.9rem !important;
    line-height:1 !important;
    color:var(--abv2-pink) !important;
    text-decoration:none !important;
  }

  .site-navbar .btn.btn-primary--bordered{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-height:44px;
    padding:0 22px !important;
    border:1.8px solid var(--abv2-pink) !important;
    border-radius:999px !important;
    background:transparent !important;
    color:var(--abv2-ink) !important;
    font-family:var(--abv2-ui) !important;
    font-size:.84rem !important;
    line-height:1 !important;
    box-shadow:none !important;
  }

  /* =========================================================
     EDITORIAL PAGE
     ========================================================= */

  .abv2-editorial,
  .abv2-editorial *{
    box-sizing:border-box;
  }

  .abv2-editorial{
    position:relative;
    overflow:hidden;
    background:var(--abv2-editorial-bg);
    color:var(--abv2-ink);
  }

  .abv2-editorial img{
    display:block;
    max-width:100%;
    height:auto;
  }

  .abv2-editorial__wrap{
    position:relative;
    width:min(calc(100% - 40px), var(--abv2-wrap));
    margin:0 auto;
    padding:34px 0 0;
  }

  /* =========================================================
     HERO
     ========================================================= */

  .abv2-ed-hero{
    position:relative;
    width:min(100%, 1040px);
    margin:0 auto;
    padding:10px 0 150px;
    overflow:visible;
  }

  .abv2-ed-hero__copy{
    position:relative;
    z-index:2;
    width:min(100%, 760px);
    margin-left:84px;
  }

  .abv2-ed-hero__title{
    margin:0;
    max-width:14ch;
    font-family:var(--abv2-serif);
    font-weight:600;
    letter-spacing:-.035em;
    font-size:clamp(2.7rem, 5.1vw, 4.35rem);
    line-height:.92;
    color:var(--abv2-ink);
  }

  .abv2-ed-hero__intro{
    margin:26px 0 0;
    max-width:60ch;
    font-family:var(--abv2-sans);
    font-size:1.18rem;
    line-height:1.72;
    color:var(--abv2-text);
  }

  .abv2-ed-hero__actions{
    display:flex;
    gap:14px;
    flex-wrap:wrap;
    margin-top:24px;
    max-width:60ch;
  }

  .abv2-ed-hero__actions .abv2-btn{
    white-space:nowrap;
  }

  .abv2-ed-hero::after{
    content:"";
    position:absolute;
    left:50%;
    bottom:0;
    transform:translateX(-50%);
    width:100vw;
    height:138px;
    background:var(--abv2-pink);
    z-index:0;
    pointer-events:none;
    clip-path:polygon(
      0 84%,
      0 100%,
      33% 36%,
      100% 76%,
      100% 60%,
      33% 20%
    );
  }

  /* =========================================================
     CONTENT RAIL / COPY
     ========================================================= */

  .abv2-ed-rail{
    position:relative;
    width:min(100%, var(--abv2-editorial-rail));
    margin:0 auto;
    z-index:2;
  }

  .abv2-ed-section{
    margin-top:12px;
  }

  .abv2-ed-copy > *{
    margin:0;
  }

  .abv2-ed-copy > * + *{
    margin-top:20px;
  }

  .abv2-ed-copy > p,
  .abv2-ed-copy > ul,
  .abv2-ed-copy > .abv2-ed-cta{
    width:min(100%, var(--abv2-editorial-copy));
  }

  .abv2-ed-copy p,
  .abv2-ed-copy li{
    font-family:var(--abv2-sans);
    font-size:1.03rem;
    line-height:1.68;
    color:var(--abv2-text);
  }

  .abv2-ed-copy ul{
    margin:4px 0 0;
    padding:0;
    list-style:none;
    width:min(100%, var(--abv2-editorial-copy));
  }

  .abv2-ed-copy li{
    position:relative;
    padding-left:1.35rem;
  }

  .abv2-ed-copy li::before{
    content:"";
    position:absolute;
    left:0;
    top:.72em;
    width:7px;
    height:7px;
    border-radius:50%;
    background:var(--abv2-pink);
    transform:translateY(-50%);
  }

  .abv2-ed-copy li + li{
    margin-top:14px;
  }

  /* =========================================================
     MEDIA
     ========================================================= */

  .abv2-media{
    position:relative;
    width:100%;
    margin:42px 0 56px;
  }

  .abv2-media--video{
    margin:38px 0 52px;
  }

  .abv2-media__frame{
    overflow:hidden;
    border-radius:24px;
    background:#ddd7d2;
  }

  .abv2-media__frame img{
    display:block;
    width:100%;
    height:auto;
  }

  .abv2-media--video .abv2-media__frame{
    border-radius:12px;
    background:#000;
  }

  .abv2-media__embed{
    position:relative;
    width:100%;
    padding-top:56.25%;
    overflow:hidden;
    border-radius:12px;
    background:#000;
  }

  .abv2-media__embed iframe{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    border:0;
  }

  /* =========================================================
     DIVIDER FAMILY
     ========================================================= */

  .abv2-ed-band{
    position:relative;
    width:100vw;
    height:138px;
    margin:18px 0 24px;
    margin-left:calc(50% - 50vw);
    pointer-events:none;
  }

  .abv2-ed-band--pink-rise{
    background:var(--abv2-pink);
    clip-path:polygon(
      0 84%,
      0 100%,
      33% 36%,
      100% 76%,
      100% 60%,
      33% 20%
    );
  }

  .abv2-ed-band--yellow-right{
    background:var(--abv2-yellow);
    clip-path:polygon(
      0 78%,
      0 94%,
      66% 30%,
      100% 48%,
      100% 32%,
      66% 14%
    );
  }

  .abv2-ed-band--teal-fall{
    background:var(--abv2-teal);
    clip-path:polygon(
      0 30%,
      0 46%,
      33% 82%,
      100% 42%,
      100% 26%,
      33% 66%
    );
  }

  .abv2-ed-band--tight{
    margin-top:8px;
    margin-bottom:12px;
  }

  .abv2-ed-band--loose{
    margin-top:34px;
    margin-bottom:34px;
  }

  /* =========================================================
     BLOB DIVIDERS
     ========================================================= */

  .abv2-ed-divider{
    position:relative;
    width:min(100%, 980px);
    min-height:220px;
    margin:34px auto 28px;
  }

  .abv2-ed-divider--intro{
    margin:18px auto 10px;
  }

  .abv2-ed-divider__blob{
    position:absolute;
    top:0;
    width:340px;
    aspect-ratio:1 / 1;
    z-index:1;
    pointer-events:none;
  }

  .abv2-ed-divider__blob::before{
    content:"";
    position:absolute;
    inset:0;
    background:var(--abv2-yellow);
    -webkit-mask-image:var(--abv2-dot-mask);
    -webkit-mask-repeat:no-repeat;
    -webkit-mask-position:center;
    -webkit-mask-size:contain;
    mask-image:var(--abv2-dot-mask);
    mask-repeat:no-repeat;
    mask-position:center;
    mask-size:contain;
  }

  .abv2-ed-divider__blob--pink::before{
    background:var(--abv2-pink);
  }

  .abv2-ed-divider__blob--teal::before{
    background:var(--abv2-teal);
  }

  .abv2-ed-divider__title{
    position:relative;
    z-index:2;
    margin:0;
    max-width:11ch;
    font-family:var(--abv2-serif);
    font-weight:600;
    letter-spacing:-.03em;
    font-size:clamp(2.15rem, 3.2vw, 3rem);
    line-height:.95;
    color:var(--abv2-ink);
  }

  .abv2-ed-divider--left .abv2-ed-divider__blob{
    left:-40px;
  }

  .abv2-ed-divider--left .abv2-ed-divider__title{
    width:420px;
    margin-left:86px;
    padding-top:74px;
    text-align:left;
  }

  .abv2-ed-divider--right{
    display:flex;
    justify-content:flex-end;
  }

  .abv2-ed-divider--right .abv2-ed-divider__blob{
    right:-26px;
  }

  .abv2-ed-divider--right .abv2-ed-divider__title{
    width:420px;
    margin-left:auto;
    margin-right:86px;
    padding-top:88px;
    text-align:right;
  }

  /* =========================================================
     SUPPORT PANEL
     ========================================================= */

  .abv2-ed-panel{
    position:relative;
    overflow:hidden;
    width:min(100%, 820px);
    margin:48px auto;
    padding:34px 36px;
    border-radius:26px;
    background:#dff1f3;
  }

  .abv2-ed-panel::after{
    content:"";
    position:absolute;
    right:-60px;
    bottom:-60px;
    width:220px;
    aspect-ratio:1 / 1;
    background:var(--abv2-teal);
    opacity:.18;
    -webkit-mask-image:var(--abv2-dot-mask);
    -webkit-mask-repeat:no-repeat;
    -webkit-mask-position:center;
    -webkit-mask-size:contain;
    mask-image:var(--abv2-dot-mask);
    mask-repeat:no-repeat;
    mask-position:center;
    mask-size:contain;
  }

  .abv2-ed-panel__inner{
    position:relative;
    z-index:1;
    max-width:56ch;
  }

  .abv2-ed-panel h3{
    margin:0 0 14px;
    font-family:var(--abv2-serif);
    font-size:1.8rem;
    line-height:1;
    color:var(--abv2-ink);
  }

  .abv2-ed-panel p{
    margin:0;
    font-family:var(--abv2-sans);
    font-size:1rem;
    line-height:1.6;
    color:var(--abv2-text);
  }

  .abv2-ed-panel .abv2-btn{
    margin-top:18px;
  }

  /* =========================================================
     BUTTONS
     ========================================================= */

  .abv2-ed-cta{
    padding-top:8px;
  }

  .abv2-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-height:46px;
    padding:12px 20px;
    border:0;
    border-radius:999px;
    background:var(--abv2-pink);
    color:#fff;
    font-family:var(--abv2-ui);
    font-size:.84rem;
    line-height:1;
    text-decoration:none;
    box-shadow:none;
  }

  .abv2-btn:hover{
    text-decoration:none;
    color:#fff;
  }

  .abv2-btn--secondary{
    background:transparent;
    color:var(--abv2-pink);
    border:1.8px solid var(--abv2-pink);
  }

  .abv2-btn--secondary:hover{
    background:transparent;
    color:var(--abv2-pink);
  }

  /* =========================================================
     FOOTER WEDGE + FOOTER
     ========================================================= */

  .abv2-footer-wedge{
    position:relative;
    z-index:1;
    height:160px;
    margin-top:0;
    margin-bottom:-2px;
    overflow:hidden;
    background:transparent;
  }

  .abv2-footer-wedge__shape{
    position:absolute;
    inset:0;
    background:var(--abv2-yellow);
    clip-path:polygon(
      0 100%,
      0 82%,
      33% 30%,
      100% 82%,
      100% 100%
    );
  }

  .bg-colour--neutral--300.bg-mask.bg-mask--t-convex{
    display:none !important;
  }

  .footer{
    position:relative;
    z-index:2;
    margin-top:0 !important;
    padding-top:48px !important;
    background:var(--abv2-yellow) !important;
    color:var(--abv2-ink) !important;
    border:0 !important;
    overflow:hidden;
  }

  .footer::before,
  .footer::after{
    content:none !important;
  }

  .footer > .container,
  .footer .footer-links > .container,
  .footer .footer-copyright > .container{
    position:relative;
    z-index:1;
    width:min(calc(100% - 36px), 1180px);
    max-width:none;
  }

  .footer .footer__risk{
    position:relative;
    max-width:1200px;
    padding:0 0 42px 230px !important;
    font-family:var(--abv2-sans);
    font-size:.97rem;
    line-height:1.62;
    color:var(--abv2-ink);
  }

  .footer .footer__risk::before{
    content:"";
    position:absolute;
    left:0;
    top:18px;
    width:180px;
    height:150px;
    background:url("https://shareinmicrosite.blob.core.windows.net/abundance/58735c61-e168-4fdb-9cde-37322c17a196.png") left top / contain no-repeat;
    pointer-events:none;
  }

  .footer .footer-links{
    position:relative;
    background:transparent !important;
    border-top:0 !important;
    padding-top:24px;
    padding-bottom:18px;
  }

  .footer .footer-links::before{
    display:none !important;
  }

  .footer .footer-links .row:first-child{
    align-items:flex-start;
  }

  .footer .footer-links .col-12{
    padding-top:0 !important;
  }

  .footer h2.heading-4{
    margin:0 0 12px;
    font-family:var(--abv2-ui);
    font-size:1rem;
    line-height:1.1;
    color:var(--abv2-ink);
  }

  .footer a,
  .footer address,
  .footer p,
  .footer span{
    font-family:var(--abv2-sans);
    font-size:.94rem;
    line-height:1.56;
    color:var(--abv2-ink) !important;
  }

  .footer address{
    font-style:normal;
    margin:0;
  }

  .footer .footer-links--support,
  .footer .footer-links--company,
  .footer .footer-links--legal{
    display:flex;
    flex-direction:column;
    gap:4px;
  }

  .footer .footer-links .row + .row{
    margin-top:34px;
  }

  .footer .footer-copyright{
    background:transparent !important;
    border-top:0 !important;
    padding:14px 0 16px !important;
    margin-top:0 !important;
  }

  .footer .footer-copyright-wrapper{
    justify-content:flex-end;
    min-height:28px;
    border-top:1px solid rgba(38,38,37,.22);
    padding-top:14px;
  }

  /* =========================================================
     RESPONSIVE
     ========================================================= */

  @media (max-width:979px){
    .site-navbar .container{
      width:min(calc(100% - 24px), 1240px);
    }

    .site-navbar .brand-navbar-header{
      min-height:62px;
    }

    .site-navbar .logo{
      width:114px;
    }

    .site-navbar .navbar-is-collapsed{
      display:block;
    }

    .site-navbar .navbar-main{
      gap:20px;
    }

    .abv2-editorial__wrap{
      width:min(calc(100% - 28px), var(--abv2-wrap));
    }

    .abv2-ed-hero{
      padding-bottom:122px;
    }

    .abv2-ed-hero__copy{
      width:min(100%, 700px);
      margin-left:0;
    }

    .abv2-ed-hero__title{
      max-width:13ch;
    }

    .abv2-ed-hero__intro{
      font-size:1.1rem;
      line-height:1.66;
    }

    .abv2-ed-hero::after,
    .abv2-ed-band{
      height:112px;
    }

    .abv2-ed-rail{
      width:min(100%, 660px);
    }

    @media (max-width:759px){

  .abv2-ed-divider{
    width:100%;
    max-width:var(--abv2-mobile-copy-rail);
    min-height:0;
    margin:26px auto 22px;
    padding-top:0;
    display:block;
    overflow:visible;
  }

  .abv2-ed-divider__blob{
    position:relative;
    width:138px;
    margin:0 0 0 -44px;
    left:0 !important;
    right:auto !important;
    top:auto;
  }

  .abv2-ed-divider__title,
  .abv2-ed-divider--left .abv2-ed-divider__title,
  .abv2-ed-divider--right .abv2-ed-divider__title{
    position:relative;
    z-index:2;
    width:auto;
    max-width:9.5ch;
    margin:-48px 0 0 0;
    padding-top:0;
    font-size:1.85rem;
    line-height:.95;
    text-align:left;
  }

}

    .footer{
      padding-top:42px !important;
    }

    .footer .footer__risk{
      max-width:none;
      padding:0 0 34px 140px !important;
    }

    .footer .footer__risk::before{
      width:110px;
