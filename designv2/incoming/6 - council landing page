  mask-image:var(--abv2-dot-mask);
  mask-repeat:no-repeat;
  mask-position:center;
  mask-size:contain;
}

.abv2-ed-illus-top__blob--teal::before{
  background:var(--abv2-teal);
}

.abv2-ed-illus-top__blob--yellow::before{
  background:var(--abv2-yellow);
}

.abv2-ed-illus-top__lino{
  position:absolute;
  z-index:2;
  top:50%;
  left:50%;
  width:68%;
  max-width:260px;
  height:auto;
  object-fit:contain;
  opacity:.9;
  pointer-events:none;
  transform:translate(-50%, -56%);
