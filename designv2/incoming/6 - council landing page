  color:#a93f77;
}

.abv2-card__eyebrow--data{
  background:rgba(239,181,42,.16);
  color:#8d6707;
}

/* =========================================================
   BULLETS — BLOB MASK LANGUAGE
   ========================================================= */

.abv2-ed-copy ul{
  list-style:none;
  padding:0;
  margin:4px 0 0;
}

.abv2-ed-copy li{
  position:relative;
  padding-left:1.5rem;
}

.abv2-ed-copy li::before{
  content:"";
  position:absolute;
  left:0;
  top:.78em;
  width:10px;
  height:8px;
  transform:translateY(-50%);
  background:var(--abv2-pink);
  -webkit-mask-image:var(--abv2-dot-mask);
  -webkit-mask-repeat:no-repeat;
  -webkit-mask-position:center;
  -webkit-mask-size:contain;
  mask-image:var(--abv2-dot-mask);
  mask-repeat:no-repeat;
  mask-position:center;
  mask-size:contain;
}

.abv2-ed-copy ol{
  counter-reset:abv2-ol;
  list-style:none;
  padding:0;
  margin:4px 0 0;
  width:min(100%, var(--abv2-editorial-copy));
}

.abv2-ed-copy ol li{
  counter-increment:abv2-ol;
  position:relative;
  padding-left:2.2rem;
}

.abv2-ed-copy ol li::before{
  content:counter(abv2-ol) ".";
  position:absolute;
  left:0;
  top:0;
  width:auto;
  height:auto;
  background:none;
  transform:none;
  font-family:var(--abv2-sans);
  font-size:1.03rem;
  line-height:1.68;
  color:var(--abv2-text);
  -webkit-mask-image:none;
  mask-image:none;
}

.abv2-ed-copy ol li::after{
  content:"";
  position:absolute;
  left:1.15rem;
  top:.82em;
  width:9px;
  height:7px;
  transform:translateY(-50%);
  background:var(--abv2-pink);
  -webkit-mask-image:var(--abv2-dot-mask);
  -webkit-mask-repeat:no-repeat;
  -webkit-mask-position:center;
  -webkit-mask-size:contain;
  mask-image:var(--abv2-dot-mask);
  mask-repeat:no-repeat;
  mask-position:center;
  mask-size:contain;
}

.abv2-compare__list,
.abv2-procon__list,
.abv2-fit__list{
  list-style:none;
  margin:0;
  padding:0;
}

.abv2-compare__list li,
.abv2-procon__list li,
.abv2-fit__list li{
  position:relative;
  padding-left:18px;
}

.abv2-compare__list li::before,
.abv2-procon__list li::before,
.abv2-fit__list li::before{
  content:"";
  position:absolute;
  left:0;
  top:.82em;
  width:9px;
  height:7px;
  transform:translateY(-50%);
  background:var(--abv2-pink);
  -webkit-mask-image:var(--abv2-dot-mask);
  -webkit-mask-repeat:no-repeat;
  -webkit-mask-position:center;
  -webkit-mask-size:contain;
  mask-image:var(--abv2-dot-mask);
  mask-repeat:no-repeat;
  mask-position:center;
  mask-size:contain;
}

.abv2-compare__list li{
